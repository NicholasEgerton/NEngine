#pragma kernel CSMain

struct Particle
{
    float2 position;
    float2 oldPosition;
    float4 color;
};

RWStructuredBuffer<Particle> particles;

uint numParticles;

//The random seed generated by the CPU. Needed as otherwise the random results are too determinsitic.
uint CPUSeed;

float deltaTime;

//INCLUDES THE RADIUS.
float2 minScreenBounds; //I.e minResolution + radius.
float2 maxScreenBounds; //I.e maxResolution - radius.

float min1DSpeed;
float max1DSpeed;

//https://www.reedbeta.com/blog/hash-functions-for-gpu-rendering/
//Generates a random unsigned integer.
uint pcg_hash(uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

int RandomSign(uint seed)
{
    uint hash = pcg_hash(seed);
    
    //If hash is even, bit is 1. If hash is odd, bit is 0.
    uint bit = hash % 2;
    
    //To make this a sign we just need to do: 2b - 1.
    //If b is 0, 2 * 0 - 1 = -1. If b is 1, 2 * 1 - 1 = 1. So we get either -1 or 1, a sign.
    return 2 * bit - 1;
}

float RandomFloat(uint seed)
{
    return float(pcg_hash(seed)) / 4294967295.0; // 2^32-1
}

float RandomFloatInRange(float minRange, float maxRange, uint seed)
{
    float alpha = RandomFloat(seed);
    return lerp(minRange, maxRange, alpha);
}

[numthreads(8, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
    {
        return;
    }
    
    Particle particle = particles[id.x];
    
    int seed = id.x + CPUSeed;
    
    float2 velocity = float2(RandomSign(seed) * RandomFloatInRange(min1DSpeed, max1DSpeed, seed + 1), RandomSign(seed + 2) * RandomFloatInRange(min1DSpeed, max1DSpeed, seed + 3));
    seed += 4;
    
    particle.oldPosition = float2(RandomFloatInRange(minScreenBounds.x, maxScreenBounds.x, seed), RandomFloatInRange(minScreenBounds.y, maxScreenBounds.y, seed + 1));
    seed += 2;
    
    //Figure out the position that makes sense with this oldPosition and velocity.
    particle.position = particle.oldPosition + velocity * deltaTime;
    
    particle.color = float4(RandomFloat(seed), RandomFloat(seed + 1), RandomFloat(seed + 2), 1);
    
    particles[id.x] = particle;
}
